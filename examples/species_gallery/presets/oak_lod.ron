// The oak's LOD chain and budget. Twigs become cards baked from a small
// library of exemplar twigs from full detail on, so even the hero level
// draws each twig's leaves in a few alpha-cut quads; leaves on thicker
// branches stay individual, thinned with their area kept. Budgets count
// the triangles drawn (instances included) and the bytes of the level's
// instanced GLB with its textures.
(
    levels: [
        (
            screen_size: 0.5,
            crossfade: 0.1,
            rings: (20.0, 3, 24),
            stations: (0.15, 1.0),
            min_branch_radius: 0.0,
            leaf_fraction: 0.6,
            clusters: Some((3, 16, 3, 0.35)),
            cell: 512,
            triangles: 300000,
            bytes: 40000000,
        ),
        (
