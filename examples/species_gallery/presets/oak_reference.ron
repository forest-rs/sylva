// Reference ranges for pedunculate oak (Quercus robur) at mature size (stem
// diameter about 0.6 to 1.7 m), as derived statistics: broad bands that
// contain the published relationships, not values copied from one table.
// Each range names the growing condition it describes; ranges with none
// hold in either. Sources (full citations in sylva_measure's docs):
//
// - "pretzsch2015": Pretzsch et al. 2015, open-grown trees;
// - "hemery2005": Hemery, Savill & Pryor 2005, trees sampled largely in
//   woodland and plantations, of stand-grown form;
// - "dapple": dapple's bark calibration (measured stem bark reflectance);
// - "sylva": a target of sylva's own where no source gives a number,
//   usually a band read from the other ranges or a review target.
(
    species: "Quercus robur",
    ranges: [
        // In the open: as wide as tall or wider, a stout stem, a low crown
        // over a short bole, and a few great limbs.
        (name: "allometry.height_to_crown_width", lo: 0.6, hi: 1.2, source: "pretzsch2015", condition: Some(Open)),
        (name: "allometry.crown_width_to_dbh", lo: 12.0, hi: 30.0, source: "pretzsch2015", condition: Some(Open)),
        (name: "allometry.slenderness", lo: 8.0, hi: 22.0, source: "pretzsch2015", condition: Some(Open)),
        (name: "allometry.crown_ratio", lo: 0.5, hi: 0.95, source: "pretzsch2015", condition: Some(Open)),
        (name: "allometry.height", lo: 12.0, hi: 28.0, source: "pretzsch2015", condition: Some(Open)),
        (name: "form.major_limbs", lo: 3.0, hi: 9.0, source: "sylva", condition: Some(Open)),
        // In a stand: tall and slender, the crown high and narrow.
        (name: "allometry.height_to_crown_width", lo: 1.5, hi: 3.5, source: "sylva", condition: Some(Stand)),
        (name: "allometry.crown_width_to_dbh", lo: 12.0, hi: 25.0, source: "hemery2005", condition: Some(Stand)),
        (name: "allometry.slenderness", lo: 35.0, hi: 80.0, source: "sylva", condition: Some(Stand)),
        (name: "allometry.crown_ratio", lo: 0.3, hi: 0.6, source: "sylva", condition: Some(Stand)),
        (name: "allometry.height", lo: 22.0, hi: 38.0, source: "sylva", condition: Some(Stand)),
        // Either way: scaffold limbs leave the stem at wide, irregular
        // angles.
        (name: "form.branch_angle.order1.mean", lo: 40.0, hi: 85.0, source: "sylva"),
        // An oak crown is gappy: its limbs show against the sky.
        (name: "crown.sky_fraction", lo: 0.08, hi: 0.4, source: "sylva"),
        // Mid-summer upper-leaf albedo, sRGB green channel.
        (name: "colour.leaf.srgb_green", lo: 55.0, hi: 85.0, source: "sylva"),
        // Measured stem barks span Y 0.07 to 0.25 (sRGB luma about 75 to
        // 137), the plausible range of dapple's bark calibration.
        (name: "colour.bark.srgb_luma", lo: 75.0, hi: 137.0, source: "dapple"),
    ],
)
