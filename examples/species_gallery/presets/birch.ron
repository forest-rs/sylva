    foliage: Some((
        site_kind: 0,
        shape: (
            length: 0.05,
            width: 0.75,
            widest_at: 0.3,
            tip: 0.95,
            lobes: 10,
            lobe_depth: 0.1,
            petiole: 0.02,
            fold: 0.1,
            curl: 0.03,
            stations: 12,
            lobe_skew: 0.4,
            auricle: 0.0,
        ),
        variants: 4,
        variation: (size: 0.2, width: 0.1, lobe_depth: 0.3),
        droop: 0.8,
        light: 0.25,
        roll_jitter: 0.8,
        seed: 7,
    )),
)
