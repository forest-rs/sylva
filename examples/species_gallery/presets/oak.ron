// An open-grown oak (Quercus robur-like): a short, stout bole that divides
// into a few massive, crooked scaffold limbs, a broad dome crown about as wide
// as it is tall, and dense, zig-zag twiggy outer growth. Oak grows
// sympodially, so limbs elbow and twigs kink at every season's shoot.
// Metres and radians, +Z up.
Species(
    name: "oak",
    growth: Hierarchical((
        trunk: (
            length: 5.5,
            length_jitter: 0.1,
            lean: 0.08,
            shape: (gnarl: 0.08, gnarl_wavelength: 3.0),
        ),
        levels: [
            // Scaffold limbs: few, heavy, spreading, arching up then out.
            (
                count: Fixed(7),
                span: (0.5, 1.0),
                arrangement: Spiral(divergence: 2.39996),
                roll_jitter: 0.35,
                position_jitter: 0.6,
                angle: [(0.0, 1.05), (0.6, 0.8), (1.0, 0.35)],
                angle_jitter: 0.15,
                length: [(0.0, 1.5), (0.5, 1.45), (1.0, 1.3)],
                length_jitter: 0.15,
                balance: 0.8,
                // Crooked scaffold: broad waves plus irregular elbows.
                shape: (
                    curve: 0.2,
                    curve_back: -0.45,
                    gnarl: 0.3,
                    gnarl_wavelength: 2.2,
                    light: 0.05,
                    sag: 0.02,
                    up: 0.03,
                    kink: 0.22,
                    kink_interval: 1.1,
                    kink_jitter: 0.5,
                ),
            ),
            // Secondary branches along the limbs.
            (
                count: PerMetre(3.5),
                span: (0.15, 1.0),
                arrangement: Spiral(divergence: 2.39996),
                roll_jitter: 0.4,
                position_jitter: 0.8,
                angle: [(0.0, 0.95), (1.0, 0.6)],
                angle_jitter: 0.2,
                length: [(0.0, 0.5), (0.6, 0.4), (1.0, 0.25)],
                length_jitter: 0.25,
                shape: (
                    curve: 0.15,
                    gnarl: 0.3,
                    gnarl_wavelength: 0.8,
                    up: 0.03,
                    sag: 0.1,
                    kink: 0.3,
                    kink_interval: 0.45,
                    kink_jitter: 0.6,
                ),
                // Spur shoots along the outer half of each branch.
                sites: Some((
                    per_metre: 10.0,
                    span: (0.45, 1.0),
                    kind: 0,
                    angle: 1.0,
                    tip_cluster: 7,
                    cluster_span: 0.1,
                )),
            ),
            // Twigs carrying the leaf sites.
            (
                count: PerMetre(15.0),
                span: (0.2, 1.0),
                arrangement: Spiral(divergence: 2.39996),
                roll_jitter: 0.5,
                position_jitter: 0.8,
                angle: [(0.0, 0.85), (1.0, 0.6)],
                angle_jitter: 0.2,
                // Short branchlets: a few seasons of growth, not whips.
                length: [(0.0, 0.2), (1.0, 0.12)],
                length_jitter: 0.3,
                // Sympodial twigs: a zig-zag at every season's growth.
                shape: (
                    gnarl: 0.3,
                    gnarl_wavelength: 0.35,
                    up: 0.05,
                    kink: 0.4,
                    kink_interval: 0.12,
                    kink_jitter: 0.3,
                ),
                // A few leaves along each twig and a whorl crowded at its tip, as
                // oak carries them.
                sites: Some((
                    per_metre: 14.0,
                    span: (0.15, 1.0),
                    kind: 0,
                    angle: 0.9,
                    tip_cluster: 9,
                    cluster_span: 0.15,
                )),
            ),
        ],
        // A broad dome. Scaffold limbs are trimmed too, so a drooping limb tip
        // cannot trail out below the crown.
        envelope: Some((
            base: 2.5,
            height: 13.0,
            radius: 9.0,
            profile: [(0.0, 0.55), (0.25, 0.95), (0.5, 1.0), (0.8, 0.8), (1.0, 0.25)],
            from_level: 0,
            min_fraction: 0.3,
        )),
        // Twig tips are 4 mm; the skeleton stops at twigs, so each metre of
        // centerline also carries the flow of the unmodeled shoots on it.
        radii: (tip_radius: 0.004, exponent: 2.3, shoots_per_metre: 28.0),
        segment_length: 0.3,
    )),
    // Pedunculate-oak leaves: obovate, five rounded lobes a side, clustered
    // at the twig ends, drooping and turning toward the light.
    foliage: Some((
        site_kind: 0,
        shape: (
            length: 0.12,
            width: 0.6,
            widest_at: 0.65,
            tip: 0.6,
            lobes: 5,
            lobe_depth: 0.4,
            petiole: 0.006,
            fold: 0.15,
            curl: 0.08,
            stations: 16,
            // Lobes point toward the tip; small ears at the base.
            lobe_skew: 0.5,
            auricle: 0.04,
        ),
        variants: 4,
        variation: (size: 0.2, width: 0.15, lobe_depth: 0.25),
        droop: 0.45,
        light: 0.6,
        roll_jitter: 0.5,
        seed: 1,
    )),
)
