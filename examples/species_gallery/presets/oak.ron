// An open-grown oak (Quercus robur-like): a short, flared, tapering bole
// whose leader dissolves into five to eight massive, crooked scaffold limbs
// at staggered heights (a decurrent habit), the lowest long, near-level and
// drooping; a broad dome crown wider than it is tall; and dense, zig-zag
// twiggy outer growth. Oak grows
// sympodially, so limbs elbow and twigs kink at every season's shoot.
// Metres and radians, +Z up.
Species(
    name: "oak",
    growth: Hierarchical((
        trunk: (
            length: 9.0,
            length_jitter: 0.2,
            lean: 0.12,
            shape: (gnarl: 0.08, gnarl_wavelength: 3.0),
        ),
        levels: [
            // Scaffold limbs: few, heavy, staggered up the stem; the lowest
            // spread near level and droop, the upper climb and shorten.
            (
                count: Range(min: 6, max: 9),
                span: (0.24, 0.92),
                arrangement: Spiral(divergence: 2.39996),
                roll_jitter: 0.45,
                position_jitter: 0.8,
                angle: [(0.0, 1.3), (0.5, 1.0), (1.0, 0.55)],
                angle_jitter: 0.2,
                length: [(0.0, 1.05), (0.5, 0.95), (1.0, 0.8)],
                length_jitter: 0.2,
                balance: 0.8,
                // Crooked scaffold: broad waves plus irregular elbows.
                shape: (
                    curve: 0.2,
                    curve_back: -0.45,
                    gnarl: 0.3,
                    gnarl_wavelength: 2.2,
                    light: 0.05,
                    sag: 0.06,
                    up: 0.0,
                    kink: 0.22,
                    kink_interval: 1.1,
                    kink_jitter: 0.5,
                ),
            ),
            // Secondary branches along the limbs.
            (
                count: PerMetre(4.5),
                span: (0.15, 1.0),
                arrangement: Spiral(divergence: 2.39996),
                roll_jitter: 0.4,
                position_jitter: 0.8,
                angle: [(0.0, 0.95), (1.0, 0.75)],
                angle_jitter: 0.2,
                length: [(0.0, 0.5), (0.6, 0.45), (1.0, 0.35)],
                length_jitter: 0.25,
                shape: (
                    curve: 0.25,
                    gnarl: 0.3,
                    gnarl_wavelength: 0.8,
                    up: 0.12,
                    sag: 0.07,
                    kink: 0.3,
                    kink_interval: 0.45,
                    kink_jitter: 0.6,
                ),
                // Spur shoots along the outer half of each branch.
                sites: Some((
                    per_metre: 10.0,
                    span: (0.45, 1.0),
                    kind: 0,
                    angle: 1.0,
                    tip_cluster: 7,
                    cluster_span: 0.1,
                )),
            ),
            // Twigs carrying the leaf sites, along most of each branch so the
            // crown's leafy shell is deep rather than a skin on the tips.
            (
                count: PerMetre(30.0),
                span: (0.2, 1.0),
                arrangement: Spiral(divergence: 2.39996),
                roll_jitter: 0.5,
                position_jitter: 0.8,
                angle: [(0.0, 1.25), (1.0, 0.8)],
                angle_jitter: 0.3,
                // Short branchlets, longest mid-clump, so each branch ends in
                // a rounded tuft of foliage.
                length: [(0.0, 0.14), (0.45, 0.3), (1.0, 0.1)],
                length_jitter: 0.3,
                // Sympodial twigs: a zig-zag at every season's growth.
                shape: (
                    gnarl: 0.3,
                    gnarl_wavelength: 0.35,
                    sag: 0.03,
                    kink: 0.4,
                    kink_interval: 0.12,
                    kink_jitter: 0.3,
                ),
                // A few leaves along each twig and a whorl crowded at its tip, as
                // oak carries them.
                sites: Some((
                    per_metre: 14.0,
                    span: (0.15, 1.0),
                    kind: 0,
                    angle: 0.9,
                    tip_cluster: 9,
                    cluster_span: 0.15,
                )),
            ),
        ],
        // A broad dome, wider than tall, skirted low. Scaffold limbs are
        // trimmed too, so a drooping limb tip cannot trail out below the
        // crown.
        envelope: Some((
            base: 1.8,
            height: 14.0,
            radius: 11.0,
            profile: [(0.0, 0.7), (0.2, 0.95), (0.45, 1.0), (0.75, 0.85), (1.0, 0.4)],
            from_level: 0,
            min_fraction: 0.3,
            // Bulges and dips a few metres across, so trimmed branches end
            // on a cloud-like surface instead of a clipped hedge.
            lumps: 0.3,
            lump_size: 3.5,
        )),
        // Twig tips are 4 mm; the skeleton stops at twigs, so each metre of
        // centerline also carries the flow of the unmodeled shoots on it.
        // The bole keeps thickening below the lowest limb.
        radii: (tip_radius: 0.004, exponent: 2.55, shoots_per_metre: 16.0, bole_taper: 0.08),
        segment_length: 0.3,
    )),
    // Pedunculate-oak leaves: obovate, five rounded lobes a side, clustered
    // at the twig ends, drooping and turning toward the light.
    foliage: Some((
        site_kind: 0,
        shape: (
            length: 0.12,
            width: 0.6,
            widest_at: 0.65,
            tip: 0.6,
            lobes: 5,
            lobe_depth: 0.4,
            petiole: 0.006,
            fold: 0.15,
            curl: 0.08,
            stations: 16,
            // Lobes point toward the tip; small ears at the base.
            lobe_skew: 0.5,
            auricle: 0.04,
        ),
        variants: 4,
        variation: (size: 0.2, width: 0.15, lobe_depth: 0.25),
        droop: 0.45,
        light: 0.6,
        roll_jitter: 0.5,
        seed: 1,
    )),
)
