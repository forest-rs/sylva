// Reference ranges for Norway spruce (Picea abies), as derived statistics:
// broad bands containing the published relationships, not values copied
// from one table. Each range names the growing condition it describes;
// ranges with none hold in either. Sources (full citations in
// sylva_measure's docs):
//
// - "kantola2004": Kantola & Mäkelä 2004, stand-grown trees;
// - "dapple": dapple's bark calibration (measured stem bark reflectance);
// - "sylva": a target of sylva's own where no source gives a number. The
//   open-grown ranges extrapolate the stand data toward open growth: a
//   lower, fuller crown and a stouter stem.
(
    species: "Picea abies",
    ranges: [
        // In the open: a cone green to the ground, several times taller
        // than wide, on a stouter stem than in a stand.
        (name: "allometry.height_to_crown_width", lo: 2.0, hi: 4.5, source: "sylva", condition: Some(Open)),
        (name: "allometry.crown_width_to_dbh", lo: 8.0, hi: 22.0, source: "sylva", condition: Some(Open)),
        (name: "allometry.slenderness", lo: 35.0, hi: 80.0, source: "sylva", condition: Some(Open)),
        (name: "allometry.crown_ratio", lo: 0.8, hi: 0.98, source: "sylva", condition: Some(Open)),
        (name: "allometry.height", lo: 15.0, hi: 35.0, source: "sylva", condition: Some(Open)),
        // In a stand: slender, with a crown on the upper half or less.
        (name: "allometry.height_to_crown_width", lo: 3.5, hi: 7.0, source: "kantola2004", condition: Some(Stand)),
        (name: "allometry.slenderness", lo: 60.0, hi: 110.0, source: "kantola2004", condition: Some(Stand)),
        (name: "allometry.crown_ratio", lo: 0.4, hi: 0.75, source: "kantola2004", condition: Some(Stand)),
        (name: "allometry.height", lo: 20.0, hi: 40.0, source: "kantola2004", condition: Some(Stand)),
        // Either way: whorl branches leave near level, the lower drooping.
        (name: "form.branch_angle.order1.mean", lo: 60.0, hi: 110.0, source: "sylva"),
        // A dense spruce crown shows little sky.
        (name: "crown.sky_fraction", lo: 0.02, hi: 0.25, source: "sylva"),
        (name: "colour.leaf.srgb_green", lo: 30.0, hi: 70.0, source: "sylva"),
        // Measured stem barks span Y 0.07 to 0.25 (sRGB luma about 75 to
        // 137), the plausible range of dapple's bark calibration.
        (name: "colour.bark.srgb_luma", lo: 75.0, hi: 137.0, source: "dapple"),
    ],
)
