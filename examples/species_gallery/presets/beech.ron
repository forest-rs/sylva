// An open-grown European beech (Fagus sylvatica): a short, smooth, grey
// bole under a broad, dense dome of many ascending limbs; the outer
// branches carry flat, near-horizontal sprays of fine, gently zig-zag
// twigs with their leaves in two rows (distichous), layered one above
// another. Beech is shade tolerant, so its crown keeps leaves deep inside.
// Metres and radians, +Z up.
Species(
    name: "beech",
    // Grown in the open, as parkland beeches are.
    grown_in: Open,
    growth: Hierarchical((
        trunk: (
            length: 12.0,
            length_jitter: 0.1,
            lean: 0.04,
            shape: (gnarl: 0.03, gnarl_wavelength: 4.0, up: 0.05),
        ),
        levels: [
            // Many limbs climbing out of the bole in a fan.
            (
                count: Range(min: 9, max: 13),
                span: (0.22, 0.95),
                arrangement: Spiral(divergence: 2.39996),
                roll_jitter: 0.4,
                position_jitter: 0.7,
                angle: [(0.0, 1.05), (0.5, 0.8), (1.0, 0.5)],
                angle_jitter: 0.2,
                length: [(0.0, 0.95), (0.5, 0.85), (1.0, 0.6)],
                length_jitter: 0.2,
                balance: 1.0,
                // Smooth, sinuous limbs that arch outward, not kinked.
                shape: (
                    curve: 0.3,
                    curve_back: -0.45,
                    gnarl: 0.22,
                    gnarl_wavelength: 2.5,
                    light: 0.06,
                    sag: 0.05,
                ),
            ),
            // Branches spread in the limb's plane, so sprays layer.
            (
                count: PerMetre(5.5),
                span: (0.12, 1.0),
                arrangement: Alternate,
                roll_jitter: 0.7,
                position_jitter: 0.8,
                angle: [(0.0, 1.0), (1.0, 0.8)],
                angle_jitter: 0.35,
                length: [(0.0, 0.5), (0.6, 0.42), (1.0, 0.28)],
                length_jitter: 0.25,
                shape: (
                    curve: 0.1,
                    gnarl: 0.3,
                    gnarl_wavelength: 0.9,
                    sag: 0.2,
                    light: 0.05,
                ),
            ),
            // Fine twigs in flat, two-ranked sprays.
            (
                count: PerMetre(28.0),
                span: (0.15, 1.0),
                arrangement: Alternate,
                roll_jitter: 0.25,
                position_jitter: 0.7,
                angle: [(0.0, 1.1), (1.0, 0.8)],
                angle_jitter: 0.25,
                length: [(0.0, 0.2), (0.5, 0.26), (1.0, 0.12)],
                length_jitter: 0.3,
                shape: (
                    gnarl: 0.2,
                    gnarl_wavelength: 0.3,
                    sag: 0.05,
                    kink: 0.25,
                    kink_interval: 0.08,
                    kink_jitter: 0.2,
                ),
                sites: Some((
                    per_metre: 32.0,
                    span: (0.1, 1.0),
                    kind: 0,
                    angle: 1.2,
                    tip_cluster: 2,
                    cluster_span: 0.1,
                )),
            ),
        ],
        // A broad dome, a little wider than tall, skirted low.
        envelope: Some((
            base: 2.0,
            height: 20.0,
            radius: 11.0,
            profile: [(0.0, 0.6), (0.2, 0.9), (0.45, 1.0), (0.75, 0.85), (1.0, 0.35)],
            from_level: 0,
            min_fraction: 0.3,
            lumps: 0.2,
            lump_size: 3.0,
        )),
        // Shade tolerant: leaves deep into the crown.
        shade: Some((shell: 0.5, interior: 0.55)),
        radii: (tip_radius: 0.003, exponent: 2.7, shoots_per_metre: 14.0, bole_taper: 0.06),
        segment_length: 0.3,
    )),
    // Beech leaves: ovate, pointed, entire with a slightly wavy margin, 7 to
    // 10 cm, held flat to the light in two rows.
    foliage: Some((
        site_kind: 0,
        shape: (
            length: 0.085,
            width: 0.62,
            widest_at: 0.42,
            tip: 0.85,
            lobes: 7,
            lobe_depth: 0.06,
            petiole: 0.008,
            fold: 0.12,
            curl: 0.04,
            stations: 12,
            lobe_skew: 0.3,
            auricle: 0.0,
        ),
        variants: 4,
        variation: (size: 0.2, width: 0.1, lobe_depth: 0.3),
        droop: 0.2,
        light: 0.8,
        roll_jitter: 0.3,
        seed: 5,
    )),
)
